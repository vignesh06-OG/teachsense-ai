# ==============================================================================
# TeachSense AI — Environment Variables
# VORTEXA 3.0 Hackathon Edition
# ==============================================================================

# System Port & Host
PORT=3000
NODE_ENV=development

# Optional LLM Key (teachsense-ai works 100% offline via local deterministic fallback)
# If provided, the system will use OpenAI for expanded semantic misconception explanations.
OPENAI_API_KEY=""

# Base URL for metadata and sitemap generation
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature Flags
NEXT_PUBLIC_ENABLE_3D_HERO="true"
NEXT_PUBLIC_ENABLE_LOCAL_FALLBACK="true"
